{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "types": ["chrome", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "tests/**/*.js", "scripts/**/*.mjs"]
}
